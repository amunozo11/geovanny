# ── Aplicación ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api
TZ=UTC
# El día del negocio: una venta de las 8 p. m. pertenece a hoy, no a mañana
TZ_NEGOCIO=America/Bogota

# ── Base de datos ─────────────────────────────────────────────
# DEBE ser un replica set: las transacciones lo exigen (DEPLOYMENT.md §1)
DATABASE_URL=mongodb://localhost:27017/geovanny?replicaSet=rs0&directConnection=true
DATABASE_NAME=geovanny

# ── Autenticación ─────────────────────────────────────────────
# Genera cada uno con: openssl rand -base64 48
JWT_SECRET=cambiame-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=cambiame-tambien-y-que-sea-distinto-del-anterior-32
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false

# ── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Tasas de cambio (docs/EXCHANGE_RATES.md) ─────────────────
# En desarrollo se dejan desactivadas: se usan tasas manuales.
RATES_ENABLED=false
RATES_REFRESH_MINUTES=60
RATES_TIMEOUT_MS=5000
RATES_ERAPI_URL=https://open.er-api.com/v6/latest/USD
RATES_DOLARAPI_URL=https://ve.dolarapi.com/v1/dolares
# PARALELO es la tasa real del negocio (RC-30b). OFICIAL solo como referencia.
RATES_VES_DEFAULT_MARKET=PARALELO

# ── Seguridad ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_LOGIN_MAX=5
BODY_LIMIT=1mb

# ── Observabilidad ────────────────────────────────────────────
LOG_LEVEL=debug

# ── Acceso ────────────────────────────────────────────────────────────
# true = la aplicación NO pide usuario ni contraseña y cualquiera que llegue
# a la dirección entra como administrador. Decidido el 20/08/2026.
ACCESO_ABIERTO=false
